{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kazu",
  "version": "0.1.0",
  "identifier": "com.abgnpr.kazu",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kazu",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "publisher": "abgnpr",
    "copyright": "\u00a9 abgnpr",
    "category": "Finance",
    "shortDescription": "Local-first NSE market analysis",
    "longDescription": "Kazu by abgnpr \u2014 a local-first desktop app for NSE market data: daily bhavcopy ingest into DuckDB, CAR + 30/50/200 DMA breakout screening, and charts that show exactly what the screen tests."
  }
}
